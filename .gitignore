node_modules/
.DS_Store
dist/
build/

# ── HIPAA: NEVER COMMIT THESE ──────────────────────────────────────────────
# Contains eCW credentials and MRN salt
.env
# Approval token store
.videnti_tokens.json
# Local PHI mapping database
.videnti/

# ── Logs (contain snapshot_ids and operational data) ──────────────────────
logs/
!logs/.gitkeep
!logs/screenshots/.gitkeep

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/
venv/
env/
*.egg

# ── Screenshots (may contain PHI if misconfigured) ────────────────────────
logs/screenshots/*.png
logs/screenshots/*.jpg

# ── macOS ─────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── IDE ───────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
